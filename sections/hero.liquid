<div
  class="hero full-width"

  {% if section.settings.background_image != blank %}
    style="background-image: url('{{ section.settings.background_image | image_url: width:2000 }}')"
  {% endif %}
>
  <div class="shopify-section">
    <div class="hero__content">
      {% if section.settings.eyebrow != blank %}
        <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="hero__title-wrapper">
          <h1 class="hero__title">{{ section.settings.heading }}</h1>
        </div>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="hero__description-wrapper">
          <p class="hero__description">{{ section.settings.description }}</p>
        </div>
      {% endif %}

      <div>
        {% render 'button',
          text: 'SHOP NOW',
          url: routes.all_products_collection_url,
          class: 'button button--secondary'
        %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .hero {
    min-height: 100vh;
    background-size: cover;
    background-position: right;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero__eyebrow {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 4.8px;
    font-family: var(--font-primary--family) !important;
    line-height: 26px;
  }
  .hero__title-wrapper {
    max-width: 900px;
  }
  .hero__title {
    line-height: 84px;
    font-weight: 400;
    font-size: 70px;
    font-family: var(--font-secondary--family) !important;
  }
  .hero__description-wrapper {
    max-width: 550px;
  }
  .hero__description {
    line-height: 29px;
    font-size: 24px;
    font-family: var(--font-secondary--family) !important;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Elevate your beauty routine",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Radiant Confidence With Our Exclusive Beauty Collection"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "ndulge in the luxury of self-care with our curated selection of premium beauty and cosmetic products "
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Demo"
    }
  ]
}
{% endschema %}
