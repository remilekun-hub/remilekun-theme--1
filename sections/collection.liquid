{% comment %}
  Collection Section

  Renders the main collection page.

  Responsibilities:
  - Display the collection title and description.
  - Render collection filters.
  - Render the collection toolbar.
  - Display products using the collection product card snippet.
  - Handle product pagination.

  Dependencies:
  - snippets/collection-filters.liquid
  - snippets/collection-toolbar.liquid
  - snippets/collection-product-card.liquid
  - assets/collection.css
  - assets/collection.js
{% endcomment %}

{{ 'collection.css' | asset_url | stylesheet_tag }}

<script src="{{ 'collection.js' | asset_url }}" defer></script>

<section
  {% comment %} class="collection-page" {% endcomment %}
  class="shopify-section"
>
  {% comment %}
    <header class="collection-header">
      <h1>{{ collection.title | escape }}</h1>

      {% if collection.description != blank %}
        <div class="collection-header__description">
          {{ collection.description }}
        </div>
      {% endif %}
    </header>
  {% endcomment %}

  {% paginate collection.products by 20 %}
    <div class="collection-layout">
      <aside class="collection-sidebar" data-collection-sidebar>
        <button
          type="button"
          class="collection-sidebar__toggle"
          data-filter-toggle
          aria-expanded="true"
          aria-controls="CollectionFilters"
        >
          Filters
          <span aria-hidden="true">+</span>
        </button>

        <div
          class="collection-sidebar__content"
          id="CollectionFilters"
          data-filter-content
        >
          {% render 'collection-filters', collection: collection %}
        </div>
      </aside>

      <div class="collection-main">
        {% render 'collection-active-filters', collection: collection %}
        {% render 'collection-toolbar', collection: collection, paginate: paginate %}

        {% if collection.products.size > 0 %}
          <div class="collection-grid">
            {% for product in collection.products %}
              {% render 'collection-product-card', product: product %}
            {% endfor %}
          </div>

        {% else %}
          <div class="collection-empty">
            <h2>No products found</h2>
            <p>Try adjusting your filters or search criteria.</p>
            <a href="{{ collection.url }}">Clear filters</a>
          </div>
        {% endif %}

        {% if paginate.pages > 1 %}
          <nav class="collection-pagination" aria-label="Pagination">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      </div>
    </div>
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
