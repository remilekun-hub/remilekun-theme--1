<div class="header-wrapper">
  <header class="shopify-section">
    <div class="header">
      <h2 class="header__title">
        {{ shop.name | link_to: routes.root_url }}
      </h2>

      <div class="header__menu">
        {% for link in section.settings.menu.links %}
          {{ link.title | link_to: link.url }}
        {% endfor %}
      </div>

      <div class="header__icons">
        {% if shop.customer_accounts_enabled %}
          <shopify-account menu="{{ section.settings.customer_account_menu }} class=" header__account-menu>
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {% endif %}

        <a href="{{ routes.cart_url }}">
          {% if cart.item_count > 0 %}
            <sup data-cart-count>{{ cart.item_count }}</sup>
          {% endif %}

          {{ 'icon-cart.svg' | inline_asset_content }}
        </a>
      </div>
    </div>
  </header>
</div>
{% stylesheet %}
  .header-wrapper {
    grid-column: 1 / -1;
  }
  .header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-darkslategray-200);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    font-size: 12px;
    transition: 0.5s color;
    line-height: 19px;
  }
  header a:hover {
    color: var(--color-indianred-100);
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    color: #fff;
    max-width: var(--page-margin);
    background-color: var(--color-indianred-100);
    width: 18px;
    height: 18px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 11px;
    font-weight: 400;
  }

  header .header__menu {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  header .header__icons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  header .header__title a {
    font-size: 24px;
  }

  .header__account-menu {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .header__account-menu svg {
    width: 14px !important;
    height: 14px !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
