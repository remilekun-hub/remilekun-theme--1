{%- liquid
  assign faq_blocks = section.blocks | where: 'type', 'faq_item'
-%}

<section
  id="CustomFaq-{{ section.id }}"
  class="custom-faq full-width gradient section-{{ section.id }}-padding"
>
  <div class="shopify-section">
    <div class=" custom-faq__inner">
      <div class="custom-faq__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="custom-faq__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="custom-faq__subheading">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}
      </div>

      <!-- FAQ Accordion -->
      <div class="custom-faq__list">
        {%- for block in faq_blocks -%}
          <details
            class="custom-faq__item"
            {% if block.settings.open_by_default %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="custom-faq__question">
              <span class="custom-faq__question-text">
                {{ block.settings.question | escape }}
              </span>

              <span class="custom-faq__icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none">
                  <path
                    d="M5 7.5L10 12.5L15 7.5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </summary>

            <div class="custom-faq__answer">
              <div class="custom-faq__answer-content rte">
                {{ block.settings.answer }}
              </div>
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<!-- FAQ SEO Structured Data -->
{%- if faq_blocks.size > 0 and section.settings.enable_schema -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in faq_blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<style>
         .section-{{ section.id }}-padding {
           padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
           padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
         }

         @media screen and (min-width: 750px) {
           .section-{{ section.id }}-padding {
             padding-top: {{ section.settings.padding_top }}px;
             padding-bottom: {{ section.settings.padding_bottom }}px;
           }
         }

         /* =========================================
            FAQ LAYOUT
         ========================================= */

          .custom-faq__inner {
           margin:0 auto;
           max-width: 1024px;
           width:100%
         }

       .custom-faq__header {
           text-align: center;
           margin-bottom: 3.2rem;

         }

       .custom-faq__heading {

           font-family: var(--font-secondary--family);
           font-size: 36px;
           font-weight: 700;
           margin-bottom: 8px !important;
         }

        .custom-faq__subheading {
          font-family: va(--font-primary--family) !important;
          font-size: 15px;
          font-weight: 400;
          line-height: 24px;
          color: #414141b3;
          text-align: center;
        }

      .custom-faq__list {
           display: flex;
           flex-direction: column;
           gap: 1.2rem;
         }

         /* =========================================
            ACCORDION CARD
         ========================================= */

       .custom-faq__item {
           border: 1px solid rgba(var(--color-foreground), 0.14);
           border-radius: 12px;
           background: rgba(var(--color-background), 0.5);
           overflow: hidden;
           transition:
             border-color 0.25s ease,
             background-color 0.25s ease;
         }

        .custom-faq__item:hover {
           border-color: rgba(var(--color-foreground), 0.35);
         }

     .custom-faq__item[open] {
           border-color: rgba(var(--color-foreground), 0.3);
           background: rgb(var(--color-background));
         }

         /* =========================================
            QUESTION
         ========================================= */

     .custom-faq__question {
           display: flex;
           justify-content: space-between;
           align-items: center;
           gap: 2rem;

           padding: 2rem 2.2rem;

           cursor: pointer;
           list-style: none;

           font-size: 1.5rem;
           font-weight: 600;
           line-height: 1.5;
         }

       .custom-faq__question::-webkit-details-marker {
           display: none;
         }

         .custom-faq__question:focus-visible {
           outline: 2px solid rgb(var(--color-foreground));
           outline-offset: -4px;
           border-radius: 10px;
         }

         .custom-faq__question-text {
           flex: 1;
         }

         /* =========================================
            CHEVRON ICON
         ========================================= */

      .custom-faq__icon {
           width: 2rem;
           height: 2rem;
           flex-shrink: 0;

           display: grid;
           place-items: center;

           border-radius: 50%;
           background: rgba(var(--color-foreground), 0.06);

           transition:
             transform 0.3s ease,
             background-color 0.3s ease;
         }

      .custom-faq__icon svg {
           display: block;
           width: 1.4rem;
           height: 1.4rem;
         }

   .custom-faq__item[open] .custom-faq__icon {
           transform: rotate(180deg);
           background: rgba(var(--color-foreground), 0.12);
         }

         /* =========================================
            ANSWER ANIMATION
         ========================================= */

          .custom-faq__answer {
           display: grid;
           grid-template-rows: 0fr;

           transition: grid-template-rows 0.3s ease;
         }

         .custom-faq__item[open] .custom-faq__answer {
           grid-template-rows: 1fr;
         }

       .custom-faq__answer-content {
           min-height: 0;
           overflow: hidden;

           padding: 0 2.2rem;

           opacity: 0;

           transition:
             opacity 0.25s ease,
             padding-bottom 0.3s ease;
         }

        .custom-faq__item[open] .custom-faq__answer-content {
           padding-bottom: 2.2rem;
           opacity: 1;
         }

        .custom-faq__answer-content > :first-child {
           margin-top: 0;
         }

        .custom-faq__answer-content > :last-child {
           margin-bottom: 0;
         }

         /* =========================================
            MOBILE
         ========================================= */

         @media screen and (max-width: 749px) {
      .custom-faq__header {
             margin-bottom: 2.4rem;
           }

           .custom-faq__list {
             gap: 1rem;
           }

     .custom-faq__question {
             padding: 1.6rem;
             font-size: 1.4rem;
           }
    .custom-faq__answer-content {
             padding-left: 1.6rem;
             padding-right: 1.6rem;
           }

    .custom-faq__item[open] .custom-faq__answer-content {
             padding-bottom: 1.6rem;
           }
         }


         @media (prefers-reduced-motion: reduce) {
     .custom-faq__item,
          .custom-faq__icon,
  .custom-faq__answer,
     .custom-faq__answer-content {
             transition: none;
           }
         }
</style>

<script>
  (() => {
    const root = document.getElementById('CustomFaq-{{ section.id }}');

    if (!root || root.dataset.faqReady) return;

    root.dataset.faqReady = 'true';

    const items = root.querySelectorAll('.custom-faq__item');

    // Keep only the first initially open item.
    let hasOpenItem = false;

    items.forEach((item) => {
      if (item.open) {
        if (hasOpenItem) {
          item.open = false;
        } else {
          hasOpenItem = true;
        }
      }
    });

    // Allow only one accordion to remain open.
    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;

        items.forEach((otherItem) => {
          if (otherItem !== item && otherItem.open) {
            otherItem.open = false;
          }
        });
      });
    });

    // Support Shopify Theme Editor section reloads.
    document.addEventListener('shopify:section:unload', (event) => {
      if (event.detail.sectionId === '{{ section.id }}') {
        delete root.dataset.faqReady;
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Custom FAQ",
  "tag": "section",
  "class": "section",
  "max_blocks": 30,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQs"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Below are some common questions"
    },

    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Add FAQ structured data (SEO)",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Write a clear, helpful answer here.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom FAQ",
      "blocks": [
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        }
      ]
    }
  ]
}
{% endschema %}
